# This file documents names. The app does not auto-load .env files.
# Set environment variables in the process that starts the studio.
CREATIVITY_MODEL=your-json-capable-model
CREATIVITY_BASE_URL=https://api.openai.com/v1
CREATIVITY_API_KEY=
# Optional distinct judge model, using the same endpoint and key:
CREATIVITY_JUDGE_MODEL=
# Some compatible providers require max_tokens instead:
CREATIVITY_TOKEN_PARAM=max_completion_tokens
